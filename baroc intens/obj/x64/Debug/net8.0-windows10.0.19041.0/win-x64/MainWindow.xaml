<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="baroc_intens.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Barroc Intens">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:ConnectionId='2' x:Name="RootGrid" Background="#F2F4F7"                           >
        <Grid x:ConnectionId='3' x:Name="LoginView" Visibility="Visible">
            <Border Width="460" Padding="40" CornerRadius="16" Background="White"
                    BorderBrush="#DDE3EA" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="18">
                    <TextBlock Text="BARROC INTENS" FontSize="13" FontWeight="SemiBold" CharacterSpacing="180"
                               Foreground="Black" />
                    <TextBlock Text="Welkom terug" FontSize="32" FontWeight="SemiBold" Foreground="Black" />
                    <TextBlock Text="Log in met je account om verder te gaan." Foreground="Black" />
                    <TextBox x:ConnectionId='11' x:Name="UsernameBox" Header="Gebruikersnaam" PlaceholderText="Gebruikersnaam"
                             Foreground="Black" Background="#F8FAFC" BorderBrush="#CBD5E1" />
                    <PasswordBox x:ConnectionId='12' x:Name="PasswordBox" Header="Wachtwoord" PlaceholderText="Wachtwoord"
                                 Foreground="Black" Background="#F8FAFC" BorderBrush="#CBD5E1" />
                    <TextBlock x:ConnectionId='13' x:Name="LoginMessage" TextWrapping="Wrap" Foreground="Black" />
                    <Button x:ConnectionId='14' x:Name="LoginButton" Content="Inloggen"                          
                            IsEnabled="False" HorizontalAlignment="Stretch"
                            Background="#DCE6F1" BorderBrush="#B8C8D9" BorderThickness="1"
                            Foreground="Black" FontWeight="SemiBold" />
                    <TextBlock Text="Demo: sales / Sales123!   •   maintenance / Maintenance123!"
                               TextWrapping="Wrap" FontSize="12" Foreground="Black" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:ConnectionId='4' x:Name="ApplicationView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#E7ECF2" Padding="24"
                    BorderBrush="#D5DDE6" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="BARROC INTENS" FontSize="17" FontWeight="SemiBold" CharacterSpacing="120"
                               Foreground="Black" />
                    <StackPanel Grid.Row="1" Margin="0,28,0,20" Spacing="6">
                        <TextBlock x:ConnectionId='9' x:Name="UserDisplayName" Foreground="Black" FontSize="16" />
                        <TextBlock x:ConnectionId='10' x:Name="UserRoleLabel" Foreground="Black" FontSize="13" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Spacing="10">
                        <Button x:ConnectionId='7' Content="Dashboard"                               HorizontalAlignment="Stretch"
                                Foreground="Black" Background="#F8FAFC" BorderBrush="#D5DDE6"
                                BorderThickness="1" FontWeight="SemiBold" />
                        <Button x:ConnectionId='8' x:Name="WorkButton"                          HorizontalAlignment="Stretch"
                                Foreground="Black" Background="#F8FAFC" BorderBrush="#D5DDE6"
                                BorderThickness="1" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button x:ConnectionId='6' Grid.Row="3" Content="Uitloggen"                           
                            HorizontalAlignment="Stretch" Foreground="Black" Background="#F8FAFC"
                            BorderBrush="#D5DDE6" BorderThickness="1" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" Padding="40" Background="#F2F4F7">
                <StackPanel x:ConnectionId='5' x:Name="ContentHost" Spacing="18" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

