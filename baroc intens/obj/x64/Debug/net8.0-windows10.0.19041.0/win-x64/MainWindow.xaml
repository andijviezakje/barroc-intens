<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="baroc_intens.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Barroc Intens">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:ConnectionId='2' x:Name="RootGrid" Background="#F3F5F7"                           >
        <Grid x:ConnectionId='3' x:Name="LoginView" Visibility="Visible">
            <Border Width="440" Padding="36" CornerRadius="12" Background="White"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="BARROC INTENS" FontSize="14" CharacterSpacing="180"
                               Foreground="#A64B3C" />
                    <TextBlock Text="Welkom terug" FontSize="30" Foreground="#172B4D" />
                    <TextBlock Text="Log in met je account om verder te gaan." Foreground="#58677A" />
                    <TextBox x:ConnectionId='11' x:Name="UsernameBox" Header="Gebruikersnaam" PlaceholderText="Gebruikersnaam" />
                    <PasswordBox x:ConnectionId='12' x:Name="PasswordBox" Header="Wachtwoord" PlaceholderText="Wachtwoord" />
                    <TextBlock x:ConnectionId='13' x:Name="LoginMessage" TextWrapping="Wrap" Foreground="#A52A2A" />
                    <Button x:ConnectionId='14' x:Name="LoginButton" Content="Inloggen"                          
                            IsEnabled="False" HorizontalAlignment="Stretch"
                            Background="#172B4D" Foreground="White" />
                    <TextBlock Text="Demo: sales / Sales123!   •   maintenance / Maintenance123!"
                               TextWrapping="Wrap" FontSize="12" Foreground="#758195" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:ConnectionId='4' x:Name="ApplicationView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#172B4D" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="BARROC INTENS" FontSize="17" CharacterSpacing="120"
                               Foreground="White" />
                    <StackPanel Grid.Row="1" Margin="0,28,0,20" Spacing="4">
                        <TextBlock x:ConnectionId='9' x:Name="UserDisplayName" Foreground="White" FontSize="16" />
                        <TextBlock x:ConnectionId='10' x:Name="UserRoleLabel" Foreground="#B9C5D6" FontSize="13" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Spacing="10">
                        <Button x:ConnectionId='7' Content="Dashboard"                               HorizontalAlignment="Stretch" />
                        <Button x:ConnectionId='8' x:Name="WorkButton"                          HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <Button x:ConnectionId='6' Grid.Row="3" Content="Uitloggen"                           
                            HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" Padding="36">
                <StackPanel x:ConnectionId='5' x:Name="ContentHost" Spacing="18" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

